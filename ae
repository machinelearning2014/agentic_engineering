#!/usr/bin/env bash
#
# ae — Agentic Engineering task helper.
# Scaffold a task, lint the spec, and record accept/reject decisions
# for the five-stage loop (Specify → Delegate → Review → Verify → Accept).
#
# No dependencies. Works with bash 3.2+ (macOS default).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TASKS_DIR="$SCRIPT_DIR/tasks"

# Substrings that mark an unfilled template field. A completed spec must
# contain none of these.
PLACEHOLDERS=(
  "<Write it here"
  "<path or module"
  "<invariant to preserve"
  "<Executable check"
  "<Change summary"
  "<Evidence: exit codes"
  "<Known limitations"
  "<command>"
  "<result>"
)

# Dependency-manifest filenames whose change is security/scope-relevant.
DEP_FILES="package.json package-lock.json yarn.lock pnpm-lock.yaml requirements.txt pyproject.toml poetry.lock Pipfile Pipfile.lock go.mod go.sum Cargo.toml Cargo.lock pom.xml build.gradle build.gradle.kts Gemfile Gemfile.lock composer.json composer.lock"

usage() {
  cat <<'EOF'
ae — Agentic Engineering task helper

Usage:
  ae new <task>                        Scaffold tasks/<task>/spec.md
  ae check [<task>]                    Lint the spec(s) for completeness; exit non-zero on failure
  ae blocker <task>                    Scaffold tasks/<task>/blocker.md
  ae review <task>                     Scaffold tasks/<task>/review.md (auto-detects diff facts)
  ae verify [<task>]                   Run the spec's acceptance-criteria commands
  ae accept <task> --evidence "..."    Record an ACCEPT decision (check + verify must pass)
  ae reject <task> --reason "..."      Record a REJECT decision
  ae status                            List every task and its loop state
  ae help                              Show this message
EOF
}

task_spec()     { printf '%s/%s/spec.md'     "$TASKS_DIR" "$1"; }
task_blocker()  { printf '%s/%s/blocker.md'  "$TASKS_DIR" "$1"; }
task_decision() { printf '%s/%s/decision.md' "$TASKS_DIR" "$1"; }
task_review()   { printf '%s/%s/review.md'   "$TASKS_DIR" "$1"; }
task_verify()   { printf '%s/%s/verify.md'   "$TASKS_DIR" "$1"; }

require_task() {
  [[ -n "$1" ]] || { echo "ae: error: missing task name" >&2; exit 1; }
  case "$1" in
    */*) echo "ae: error: task name must not contain '/'" >&2; exit 1 ;;
  esac
}

# --- review auto-detection helpers ----------------------------------------

is_in_git() {
  git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

changed_files() {
  git -C "$SCRIPT_DIR" status --porcelain -z | while IFS= read -r -d '' entry; do
    status="${entry:0:2}"
    path="${entry:3}"
    printf '%s\n' "$path"
    case "$status" in
      R*|C*) IFS= read -r -d '' _src || true ;;
    esac
  done | grep -v '^tasks/' || true
}

spec_scope() {
  sed -n '/^## Scope/,/^## Do not change/p' "$1" \
    | sed -n 's/^- //p' \
    | sed 's/[[:space:]]*$//' \
    | sed '/^$/d'
}

spec_publication() {
  sed -n '/^## Publication intent/,/^## Acceptance criteria/p' "$1" \
    | sed -n 's/^- \[x\] //p'
}

in_scope() {
  local f="$1" entries="$2" s
  while IFS= read -r s; do
    s="${s%/}"
    [[ -z "$s" ]] && continue
    if [[ "$f" == $s || "$f" == $s/* ]]; then
      return 0
    fi
  done <<< "$entries"
  return 1
}

is_dep_file() {
  local b; b="$(basename "$1")"
  case " $DEP_FILES " in
    *" $b "*) return 0 ;;
  esac
  return 1
}

is_test_file() {
  local f="$1" b
  b="$(basename "$f")"
  case "$f" in
    test/*|tests/*|__tests__/*|spec/*|*/test/*|*/tests/*|*/__tests__/*) return 0 ;;
  esac
  case "$b" in
    *_test.*|*.test.*|test_*|*_spec.*|*.spec.*|*Test.*|*Tests.*) return 0 ;;
  esac
  return 1
}

emit_facts() {
  local spec="$1" pub scope files f dep_found test_found n removed
  pub="$(spec_publication "$spec")"
  echo "### Publication intent (from the spec)"
  if [[ -n "$pub" ]]; then
    echo "- $pub"
  else
    echo "- (none checked — spec is incomplete)"
  fi
  echo

  if ! is_in_git; then
    echo "### Changed files"
    echo "- (not a git repository — auto-detection skipped; review \`git diff\` manually)"
    return 0
  fi

  files="$(changed_files | sort -u)"
  echo "### Changed files"
  if [[ -z "$files" ]]; then
    echo "- (none — did the agent actually produce a diff?)"
  else
    while IFS= read -r f; do
      if [[ -z "$f" ]]; then
        continue
      fi
      echo "- $f"
    done <<< "$files"
  fi
  echo

  scope="$(spec_scope "$spec")"
  echo "### Scope check"
  if [[ -z "$scope" ]]; then
    echo "- (no Scope entries in the spec — cannot check)"
  else
    while IFS= read -r f; do
      if [[ -z "$f" ]]; then
        continue
      fi
      if in_scope "$f" "$scope"; then
        echo "- ✓ in scope: $f"
      else
        echo "- ⚠️  OUT OF SCOPE: $f"
      fi
    done <<< "$files"
  fi
  echo

  echo "### Dependencies"
  dep_found=""
  while IFS= read -r f; do
    if [[ -z "$f" ]]; then
      continue
    fi
    if is_dep_file "$f"; then
      dep_found=1
      echo "- ⚠️  dependency manifest changed: $f"
    fi
  done <<< "$files"
  if [[ -z "$dep_found" ]]; then
    echo "- none"
  fi
  echo

  echo "### Test changes"
  test_found=""
  removed=0
  while IFS= read -r f; do
    if [[ -z "$f" ]]; then
      continue
    fi
    if is_test_file "$f"; then
      test_found=1
      echo "- modified: $f"
      n=$(git -C "$SCRIPT_DIR" diff -- "$f" | grep -cE '^-[^-]' || true)
      removed=$((removed + n))
    fi
  done <<< "$files"
  if [[ -n "$test_found" ]]; then
    if [[ "$removed" -gt 0 ]]; then
      echo "- ⚠️  $removed line(s) removed from test files — check for test weakening"
    fi
  else
    echo "- none"
  fi
}

# --- commands -------------------------------------------------------------

cmd_new() {
  require_task "$1"
  local spec; spec="$(task_spec "$1")"
  if [[ -e "$spec" ]]; then
    echo "ae: error: $spec already exists" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$spec")"
  { printf '# Task Specification — %s\n' "$1"; tail -n +2 "$SCRIPT_DIR/spec-template.md"; } > "$spec"
  echo "Created $spec"
  echo "Next: fill in EVERY field, then run 'ae check $1'."
}

cmd_blocker() {
  require_task "$1"
  local blocker; blocker="$(task_blocker "$1")"
  if [[ -e "$blocker" ]]; then
    echo "ae: error: $blocker already exists" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$blocker")"
  { printf '# Blocker Record — %s\n' "$1"; tail -n +2 "$SCRIPT_DIR/blocker-record.md"; } > "$blocker"
  echo "Created $blocker"
}

cmd_review() {
  require_task "$1"
  local spec review
  spec="$(task_spec "$1")"
  review="$(task_review "$1")"
  if [[ ! -f "$spec" ]]; then
    echo "ae: error: no spec at $spec — run 'ae new $1' first" >&2
    exit 1
  fi
  if [[ -e "$review" ]]; then
    echo "ae: error: $review already exists" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$review")"
  {
    echo "# Review Checklist — $1"
    echo
    echo "> Auto-generated by \`ae review\` on $(date '+%Y-%m-%d %H:%M:%S')."
    echo "> Review the auto-detected facts, then work the checklist below."
    echo
    echo "## Auto-detected facts"
    echo
    emit_facts "$spec"
    echo
    echo "---"
    echo
    tail -n +2 "$SCRIPT_DIR/review-checklist.md"
  } > "$review"
  echo "Created $review"
}

check_spec() {
  local spec="$1" fails=0
  if [[ ! -f "$spec" ]]; then
    echo "  ✗ missing spec file: $spec"
    return 1
  fi

  local p n crits
  for p in "${PLACEHOLDERS[@]}"; do
    if grep -qF -- "$p" "$spec"; then
      echo "  ✗ unfilled field: $p"
      fails=$((fails + 1))
    fi
  done

  n=$(grep -cE '^- \[x\]' "$spec" || true)
  if [[ "$n" -ne 1 ]]; then
    echo "  ✗ publication intent: expected exactly one '- [x]', found $n"
    fails=$((fails + 1))
  fi

  crits=$(sed -n '/^## Acceptance criteria/,/^## Output contract/p' "$spec" \
          | grep -cE '^[0-9]+\.' || true)
  if [[ "$crits" -lt 1 ]]; then
    echo "  ✗ acceptance criteria: need at least one numbered criterion"
    fails=$((fails + 1))
  fi

  if [[ "$fails" -eq 0 ]]; then
    echo "  ✓ spec checks pass"
    return 0
  fi
  return 1
}

cmd_check() {
  if [[ $# -eq 0 ]]; then
    if [[ ! -d "$TASKS_DIR" ]] || ! compgen -G "$TASKS_DIR/*/spec.md" >/dev/null; then
      echo "No tasks yet — run 'ae new <task>'."
      return 0
    fi
    local s rc=0
    for s in "$TASKS_DIR"/*/spec.md; do
      [[ -e "$s" ]] || continue
      echo "${s#$SCRIPT_DIR/}"
      check_spec "$s" || rc=1
    done
    return "$rc"
  fi

  require_task "$1"
  check_spec "$(task_spec "$1")"
}

criteria_lines() {
  sed -n '/^## Acceptance criteria/,/^## Output contract/p' "$1" \
    | grep -E '^[0-9]+\.'
}

first_command() {
  printf '%s' "$1" | sed -n 's/^[^`]*`\([^`]*\)`.*/\1/p'
}

run_verify_task() {
  local task="$1" spec line cmd rc out total=0 passed=0 body="" verifyf
  spec="$(task_spec "$task")"
  if [[ ! -f "$spec" ]]; then
    echo "ae: error: no spec at $spec — run 'ae new $task' first" >&2
    return 1
  fi

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    cmd="$(first_command "$line")"
    total=$((total + 1))
    if [[ -z "$cmd" ]]; then
      body+="- ✗ (no command found) $line"$'\n'
      continue
    fi
    if out=$( ( cd "$SCRIPT_DIR" && bash -c "$cmd" ) 2>&1 ); then
      rc=0
    else
      rc=$?
    fi
    if [[ $rc -eq 0 ]]; then
      passed=$((passed + 1))
      body+="- ✓ (exit 0) $cmd"$'\n'
    else
      body+="- ✗ (exit $rc) $cmd"$'\n'
      body+="  output: $(printf '%s' "$out" | tail -n 3 | tr '\n' ' ')"$'\n'
    fi
  done <<< "$(criteria_lines "$spec")"

  local result="FAIL"
  if [[ "$total" -gt 0 && "$passed" -eq "$total" ]]; then
    result="PASS"
  fi

  verifyf="$(task_verify "$task")"
  mkdir -p "$(dirname "$verifyf")"
  {
    echo "# Verification — $task"
    echo
    echo "- **Date:** $(date '+%Y-%m-%d %H:%M:%S')"
    echo "- **Result:** $result"
    echo
    echo "## Criteria"
    echo
    printf '%s' "$body"
  } > "$verifyf"

  echo "$task — verify: $result ($passed/$total)"
  printf '%s' "$body"
  if [[ "$result" = "FAIL" ]]; then
    return 1
  fi
  return 0
}

cmd_verify() {
  if [[ $# -eq 0 ]]; then
    if [[ ! -d "$TASKS_DIR" ]] || ! compgen -G "$TASKS_DIR/*/spec.md" >/dev/null; then
      echo "No tasks yet — run 'ae new <task>'."
      return 0
    fi
    local s rc=0
    for s in "$TASKS_DIR"/*/spec.md; do
      [[ -e "$s" ]] || continue
      run_verify_task "$(basename "$(dirname "$s")")" || rc=1
    done
    return "$rc"
  fi

  require_task "$1"
  run_verify_task "$1"
}

cmd_accept() {
  local task="$1"; shift
  require_task "$task"
  local evidence=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --evidence) evidence="$2"; shift 2 ;;
      *) echo "ae: error: unknown option: $1" >&2; usage; exit 1 ;;
    esac
  done
  local spec decision
  spec="$(task_spec "$task")"
  decision="$(task_decision "$task")"
  if [[ ! -f "$spec" ]]; then
    echo "ae: error: no spec at $spec — run 'ae new $task' first" >&2
    exit 1
  fi
  if ! check_spec "$spec"; then
    echo "ae: error: spec does not pass 'ae check' — fix it first" >&2
    exit 1
  fi
  if [[ ! -f "$(task_verify "$task")" ]] || ! grep -q '^- \*\*Result:\*\* PASS$' "$(task_verify "$task")"; then
    echo "ae: error: no passing verification — run 'ae verify $task' first" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$decision")"
  {
    echo "# Acceptance Decision — $task"
    echo
    echo "- **Task:** $spec"
    echo "- **Date:** $(date '+%Y-%m-%d %H:%M:%S')"
    echo
    echo "## Decision"
    echo
    echo "**ACCEPT**"
    echo
    echo "## Evidence"
    echo
    if [[ -n "$evidence" ]]; then echo "$evidence"; else echo "(no evidence recorded)"; fi
  } > "$decision"
  echo "Recorded ACCEPT in $decision"
}

cmd_reject() {
  local task="$1"; shift
  require_task "$task"
  local reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason) reason="$2"; shift 2 ;;
      *) echo "ae: error: unknown option: $1" >&2; usage; exit 1 ;;
    esac
  done
  local decision
  decision="$(task_decision "$task")"
  mkdir -p "$(dirname "$decision")"
  {
    echo "# Acceptance Decision — $task"
    echo
    echo "- **Task:** $(task_spec "$task")"
    echo "- **Date:** $(date '+%Y-%m-%d %H:%M:%S')"
    echo
    echo "## Decision"
    echo
    echo "**REJECT**"
    echo
    echo "## Reason"
    echo
    if [[ -n "$reason" ]]; then echo "$reason"; else echo "(no reason recorded)"; fi
    echo
    echo "Next: re-enter the loop at Specify/Delegate (spec gap / route failure / verification failure)."
  } > "$decision"
  echo "Recorded REJECT in $decision"
}

cmd_status() {
  if [[ ! -d "$TASKS_DIR" ]] || ! compgen -G "$TASKS_DIR/*/spec.md" >/dev/null; then
    echo "No tasks yet — run 'ae new <task>'."
    return 0
  fi
  local spec task decision review verifyf state total checked
  for spec in "$TASKS_DIR"/*/spec.md; do
    [[ -e "$spec" ]] || continue
    task="$(basename "$(dirname "$spec")")"
    if check_spec "$spec" >/dev/null 2>&1; then state="check: pass"; else state="check: FAIL"; fi
    review="$(task_review "$task")"
    if [[ -f "$review" ]]; then
      total=$(grep -cE '^- \[[ xX]\]' "$review" || true)
      checked=$(grep -cE '^- \[[xX]\]' "$review" || true)
      state="$state · review: $checked/$total"
    else
      state="$state · review: —"
    fi
    verifyf="$(task_verify "$task")"
    if [[ -f "$verifyf" ]] && grep -q '^- \*\*Result:\*\* PASS$' "$verifyf"; then
      state="$state · verify: pass"
    elif [[ -f "$verifyf" ]] && grep -q '^- \*\*Result:\*\* FAIL$' "$verifyf"; then
      state="$state · verify: FAIL"
    else
      state="$state · verify: —"
    fi
    decision="$(task_decision "$task")"
    if [[ -f "$decision" ]]; then
      if grep -q '^\*\*ACCEPT\*\*' "$decision"; then state="$state · decision: ACCEPT"; fi
      if grep -q '^\*\*REJECT\*\*' "$decision"; then state="$state · decision: REJECT"; fi
    else
      state="$state · decision: —"
    fi
    echo "$task — $state"
  done
}

main() {
  local cmd="${1:-help}"
  if [[ $# -gt 0 ]]; then shift; fi
  case "$cmd" in
    new)      cmd_new "$@" ;;
    check)    cmd_check "$@" ;;
    verify)   cmd_verify "$@" ;;
    blocker)  cmd_blocker "$@" ;;
    review)   cmd_review "$@" ;;
    accept)   cmd_accept "$@" ;;
    reject)   cmd_reject "$@" ;;
    status)   cmd_status "$@" ;;
    help|-h|--help) usage ;;
    *) echo "ae: unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}

main "$@"
